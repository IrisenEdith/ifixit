---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import IconMark from "../../../components/IconMark.astro";
---

<BaseLayout
  title="Bericht verzonden — ifixIT"
  description="Je bericht is verzonden. Ik neem zo snel mogelijk contact met je op."
  path="/contact/bedankt/"
>
  <section class="relative overflow-hidden bg-gradient-to-br from-navy-900 to-navy-600 py-24 text-center text-white">
    <div class="container-page" data-reveal>
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand-500/15">
        <IconMark name="check" class="h-8 w-8 text-brand-400" />
      </div>
      <h1 class="mt-6 text-3xl font-bold sm:text-4xl">Bedankt voor <span class="text-gradient-accent">je bericht!</span></h1>
      <p class="mx-auto mt-4 max-w-md text-white/70">
        Je bericht is goed aangekomen. Ik neem zo snel mogelijk contact met je op.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-primary inline-flex items-center gap-2 rounded-md px-6 py-3 text-sm font-semibold">
          Terug naar home
        </a>
        <a
          href="https://wa.me/32476284847?text=Hallo%20Iris%2C%20ik%20heb%20een%20vraag%20over%20mijn%20computer."
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary-dark inline-flex items-center gap-2 rounded-md px-6 py-3 text-sm font-semibold"
        >
          <IconMark name="whatsapp" class="h-4 w-4" />
          WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
