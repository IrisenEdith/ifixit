---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Privacybeleid — ifixIT"
  description="Privacybeleid van ifixIT over de verwerking van persoonsgegevens."
  path="/privacybeleid/"
>
  <section class="bg-navy-900 py-14 text-white">
    <div class="container-page">
      <h1 class="text-3xl font-extrabold sm:text-4xl">Privacybeleid</h1>
    </div>
  </section>
  <section class="container-page max-w-3xl py-14 text-ink/80">
    <p class="leading-relaxed">
      Deze pagina volgt binnenkort met het volledige privacybeleid van ifixIT. Voor vragen over hoe je gegevens
      worden verwerkt kan je ondertussen steeds
      <a href="/contact/" class="font-semibold text-brand-600 underline underline-offset-4">contact</a> opnemen.
    </p>
  </section>
</BaseLayout>
