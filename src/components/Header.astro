---
import { Image } from "astro:assets";
import logoIcon from "../assets/logo-icon.png";

const navItems = [
  { href: "/", label: "Home" },
  { href: "/diensten/", label: "Diensten" },
  { href: "/over-mij/", label: "Over mij" },
  { href: "/diensten/#tarieven", label: "Tarieven" },
  { href: "/faq/", label: "FAQ" },
  { href: "/contact/", label: "Contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-navy-900/95 backdrop-blur">
  <div class="container-page flex h-20 items-center justify-between">
    <a href="/" class="flex items-center gap-3 shrink-0">
      <Image
        src={logoIcon}
        alt="ifixIT logo"
        width={88}
        height={80}
        loading="eager"
        class="h-10 w-10 object-contain"
      />
      <span class="flex flex-col leading-none">
        <span class="font-display text-2xl font-bold tracking-tight">
          <span class="text-white">ifix</span><span class="text-brand-400">IT</span>
        </span>
        <span class="font-mono text-[10px] tracking-[0.15em] text-white/50">UW IT. MIJN ZORG. UW RUST.</span>
      </span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Hoofdnavigatie">
      {navItems.map((item) => {
        const isActive = item.href !== "/" && item.href.startsWith("/") && !item.href.includes("#")
          ? currentPath.startsWith(item.href)
          : currentPath === item.href;
        return (
          <a
            href={item.href}
            class:list={[
              "font-mono text-xs uppercase tracking-[0.12em] transition-colors",
              isActive ? "text-brand-400" : "text-white/80 hover:text-white",
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="hidden lg:block">
      <a
        href="/contact/"
        class="btn-primary inline-flex items-center gap-2 rounded-md px-5 py-2.5 text-sm font-semibold"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4">
          <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
          <path d="M3 9h18M8 2v4M16 2v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        Maak een afspraak
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-md border border-white/20 text-white lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5">
        <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-white/10 lg:hidden" aria-label="Mobiele navigatie">
    <div class="container-page flex flex-col gap-1 py-4">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="rounded-md px-3 py-2.5 text-sm font-semibold uppercase tracking-wide text-white/80 hover:bg-white/5 hover:text-white"
        >
          {item.label}
        </a>
      ))}
      <a
        href="/contact/"
        class="btn-primary mt-2 inline-flex items-center justify-center gap-2 rounded-md px-5 py-3 text-sm font-semibold"
      >
        Maak een afspraak
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
  });
</script>
