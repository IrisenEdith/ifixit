  </svg>
)}
{name === "mail" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class={className}>
    <rect x="2" y="4" width="20" height="16" rx="2" stroke="currentColor" stroke-width="1.7"/>
    <path d="m2 7 10 6 10-6" stroke="currentColor" stroke-width="1.7"/>
  </svg>
)}
{name === "pin" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class={className}>
    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" stroke="currentColor" stroke-width="1.7"/>
    <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="1.7"/>
  </svg>
)}
{name === "laptop" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class={className}>
    <rect x="4" y="4" width="16" height="11" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
    <path d="M2 19h20M9 15v2h6v-2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === "chip" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class={className}>
    <rect x="7" y="7" width="10" height="10" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
    <path d="M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
  </svg>
)}
{name === "ram" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class={className}>
    <rect x="3" y="7" width="18" height="10" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
    <path d="M7 7v3M11 7v3M15 7v3M7 17v2M11 17v2M15 17v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
  </svg>
)}
{name === "wrench" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class={className}>
    <path d="M14.5 6.5a4 4 0 0 0-5.4 4.6L3 17.2l2.8 2.8 6.1-6.1a4 4 0 0 0 4.6-5.4l-2.6 2.6-2.1-.7-.7-2.1 2.4-2.4Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
  </svg>
)}
{name === "screen" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class={className}>
    <rect x="3" y="4" width="18" height="13" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
    <path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    <path d="m8 12 2.5-3 2.5 3 2.5-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === "windows" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class={className}>
    <path d="M3 5.5 11 4.4V11H3V5.5ZM12 4.3 21 3v8H12V4.3ZM3 12h8v6.6L3 17.5V12ZM12 12h9v8l-9-1.3V12Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
  </svg>
)}
{name === "gear" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class={className}>
    <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/>
    <path d="M12 3v2.5M12 18.5V21M21 12h-2.5M5.5 12H3M18.4 5.6l-1.8 1.8M7.4 16.6l-1.8 1.8M18.4 18.4l-1.8-1.8M7.4 7.4 5.6 5.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
  </svg>
)}
{name === "cloud" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class={className}>
    <path d="M7 18a4.5 4.5 0 0 1-.5-8.97A5.5 5.5 0 0 1 17.3 8.1 4 4 0 0 1 17 18H7Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
    <path d="M12 10.5v6M9.5 14l2.5-2.5 2.5 2.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === "speed" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class={className}>
    <circle cx="12" cy="13" r="8" stroke="currentColor" stroke-width="1.8"/>
    <path d="M12 13 16 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    <path d="M9 5.5h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
  </svg>
)}
{name === "info" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class={className}>
    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/>
    <path d="M12 11v5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    <circle cx="12" cy="8" r="1" fill="currentColor"/>
  </svg>
)}
{name === "truck" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class={className}>
    <path d="M2 7h11v9H2zM13 10h4l4 3v3h-8z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
    <circle cx="6.5" cy="18" r="1.6" stroke="currentColor" stroke-width="1.5"/>
    <circle cx="17" cy="18" r="1.6" stroke="currentColor" stroke-width="1.5"/>
  </svg>
)}
{name === "code" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class={className}>
    <path d="m9 8-4.5 4L9 16M15 8l4.5 4L15 16M13.5 6l-3 12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === "heart" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class={className}>
    <path d="M12 20s-7-4.35-9.5-8.8C.9 8 2.4 4.5 6 4.1c2-.2 3.6.9 6 3.4 2.4-2.5 4-3.6 6-3.4 3.6.4 5.1 3.9 3.5 7.1C19 15.65 12 20 12 20Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
  </svg>
)}
{name === "thumbsup" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class={className}>
    <path d="M7 11v9H4v-9h3Zm0 0 3.5-7a2 2 0 0 1 2 2v3H18a2 2 0 0 1 2 2.2l-1 6A2 2 0 0 1 17 19H7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/>
  </svg>
)}
