---
import BaseLayout from "../../layouts/BaseLayout.astro";
import IconMark from "../../components/IconMark.astro";

const contactInfo = [
  {
    title: "WhatsApp",
    value: "Stuur een bericht",
    href: "https://wa.me/32476284847?text=Hallo%20Iris%2C%20ik%20heb%20een%20vraag%20over%20mijn%20computer.",
    icon: "whatsapp",
    external: true,
  },
  { title: "E-mail", value: "iris@irisduym.be", href: "mailto:iris@irisduym.be", icon: "mail" },
  { title: "Locatie", value: "Diepenbeek", href: null, icon: "pin" },
  { title: "Openingsuren", value: "Ma – Vr: 9:00 – 18:00", href: null, icon: "clock" },
];
---

<BaseLayout
  title="Contact — ifixIT"
  description="Neem contact op met ifixIT in Diepenbeek voor een vrijblijvende diagnose of vraag over PC- en laptopherstellingen, hardware upgrades of software problemen."
  path="/contact/"
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-navy-900 to-navy-600 text-white">
    <div class="container-page py-16 text-center" data-reveal>
      <h1 class="text-4xl font-bold sm:text-5xl"><span class="text-gradient-accent">Contact</span></h1>
      <p class="mx-auto mt-4 max-w-xl text-white/70">
        Vraag, probleem of gewoon een vrijblijvende diagnose? Ik help je graag verder.
      </p>
    </div>
  </section>

  <!-- Content -->
  <section class="bg-surface py-16">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_1.2fr]">
      <!-- Info -->
      <div class="space-y-4" data-reveal>
        {contactInfo.map((item) => (
          <div class="flex items-start gap-4 rounded-[20px] border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-50">
              <IconMark name={item.icon} class="h-5 w-5 text-brand-600" />
            </div>
            <div>
              <h2 class="text-xs font-bold uppercase tracking-wide text-ink-muted">{item.title}</h2>
              {item.href ? (
                <a
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                  class="mt-1 block font-semibold text-ink hover:text-brand-600"
                >
                  {item.value}
                </a>
              ) : (
                <p class="mt-1 font-semibold text-ink">{item.value}</p>
              )}
            </div>
          </div>
        ))}

        <div class="rounded-[20px] bg-navy-900 p-6 text-white">
          <h2 class="flex items-center gap-2 font-bold">
            <IconMark name="truck" class="h-5 w-5 text-brand-400" />
            Ophaal- &amp; terugbrengservice
          </h2>
          <p class="mt-2 text-sm text-white/60">
            Kan je niet langskomen? Binnen een straal van 15 km haal ik je computer op voor € 10. Daarbuiten op aanvraag.
          </p>
        </div>
      </div>

      <!-- Form -->
      <div class="card p-8" data-reveal>
        <h2 class="text-xl font-bold text-ink">Stuur een bericht</h2>
        <p class="mt-1 text-sm text-ink-muted">
          Vul het formulier in, ik neem zo snel mogelijk contact met je op.
        </p>
        <form
          name="contact"
          method="POST"
          action="/contact/bedankt/"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="mt-6 space-y-5"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>
              Niet invullen indien je een mens bent: <input name="bot-field" />
            </label>
          </p>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="text-sm font-semibold text-ink">Naam</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                class="mt-1.5 w-full rounded-md border border-slate-300 px-3.5 py-2.5 text-sm text-ink focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
              />
            </div>
            <div>
              <label for="phone" class="text-sm font-semibold text-ink">Telefoon (optioneel)</label>
              <input
                id="phone"
                name="phone"
                type="tel"
                class="mt-1.5 w-full rounded-md border border-slate-300 px-3.5 py-2.5 text-sm text-ink focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
              />
            </div>
          </div>
          <div>
            <label for="email" class="text-sm font-semibold text-ink">E-mail</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="mt-1.5 w-full rounded-md border border-slate-300 px-3.5 py-2.5 text-sm text-ink focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
            />
          </div>
          <div>
            <label for="message" class="text-sm font-semibold text-ink">Bericht</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="mt-1.5 w-full rounded-md border border-slate-300 px-3.5 py-2.5 text-sm text-ink focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
            ></textarea>
          </div>
          <button
            type="submit"
            class="btn-primary inline-flex items-center gap-2 rounded-md px-6 py-3 text-sm font-semibold"
          >
            Verstuur bericht
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
