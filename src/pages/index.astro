---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PlaceholderImage from "../components/PlaceholderImage.astro";
import IconMark from "../components/IconMark.astro";
import resultaatVisual from "../assets/resultaat-visual.png";
import heroIris from "../assets/hero-iris-v2.png";
import waaromKiezen from "../assets/waarom-kiezen-v2.png";

const whyPoints = [
  {
    title: "Minder stof",
    description: "Een propere computer blijft koeler, stiller en heeft minder kans op problemen.",
    icon: "sparkles",
  },
  {
    title: "Meer snelheid",
    description: "Je computer start sneller op en programma's werken opnieuw vlot en stabiel.",
    icon: "bolt",
  },
  {
    title: "Betere beveiliging",
    description: "Updates en beveiliging zorgen ervoor dat je gegevens en privacy beschermd blijven.",
    icon: "shield",
  },
  {
    title: "Langere levensduur",
    description: "Regelmatig onderhoud verlengt de levensduur van je computer en voorkomt dure herstellingen.",
    icon: "clock",
  },
];

const steps = [
  {
    n: 1,
    title: "Volledige diagnose",
    description: "Ik controleer de algemene gezondheid van je computer.",
    bullets: ["SSD / HDD", "RAM Geheugen", "Temperaturen", "Ventilatoren", "Windows & Drivers"],
  },
  {
    n: 2,
    title: "Interne reiniging",
    description: "Ik verwijder stof uit ventilatoren, koelblokken, voeding en behuizing.",
  },
  {
    n: 3,
    title: "Koeling controleren",
    description: "Indien nodig vervang ik de koelpasta.",
    bullets: ["Lagere temperaturen", "Minder lawaai", "Betere prestaties", "Langere levensduur"],
  },
  {
    n: 4,
    title: "Windows optimaliseren",
    description: "Ik verwijder onnodige bestanden en programma's en optimaliseer Windows voor maximale prestaties.",
  },
  {
    n: 5,
    title: "Beveiliging controleren",
    description: "Ik scan op virussen, malware, spyware en verdachte software. Alle beveiligingsupdates worden uitgevoerd.",
  },
  {
    n: 6,
    title: "Controle van SSD/HDD",
    description: "Ik controleer de gezondheid van je opslag. Zo voorkom ik dataverlies.",
  },
  {
    n: 7,
    title: "Drivers & software updaten",
    description: "Alle belangrijke software wordt bijgewerkt.",
    bullets: ["Windows", "Drivers", "Browser", "Office & andere programma's"],
  },
  {
    n: 8,
    title: "Eindcontrole",
    description: "Alles wordt nog eens grondig getest voor je computer terug naar huis gaat.",
    bullets: ["Temperaturen", "Prestaties", "Stabiliteit", "Opstarttijd"],
  },
];

const before = ["Trage opstart", "Veel lawaai", "Hoge temperatuur", "Onveilige software", "Grote kans op fouten"];
const after = ["Snelle opstart", "Stille ventilatoren", "Betere koeling", "Alles up-to-date en veilig", "Stabiel en betrouwbaar systeem"];

const whyChooseUs = [
  { title: "Altijd rechtstreeks contact", description: "Je spreekt altijd rechtstreeks met mij.", icon: "user" },
  { title: "Eerlijke uitleg", description: "In gewone mensentaal.", icon: "chat" },
  { title: "Geen verborgen kosten", description: "Duidelijke prijzen, vooraf besproken.", icon: "tag" },
  { title: "Geen verrassingen", description: "Wat we afspreken, is wat je krijgt.", icon: "check" },
  { title: "Kwaliteit boven snelheid", description: "Ik neem de tijd voor een perfect resultaat.", icon: "star" },
  { title: "Nazorg altijd mogelijk", description: "Ook na het onderhoud sta ik voor je klaar.", icon: "headset" },
];
---

<BaseLayout
  title="ifixIT — PC & laptop herstellingen in Diepenbeek"
  description="Geef je computer een tweede jeugd. Professioneel computeronderhoud, herstellingen en optimalisatie in Diepenbeek. Snel, veilig en persoonlijk advies van Iris."
  path="/"
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy-900 text-white">
    <div class="grid lg:min-h-[680px] lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:items-stretch">
      <div class="flex flex-col justify-center gap-6 px-6 py-16 sm:px-10 lg:px-16 lg:py-20 xl:pl-24" data-reveal>
        <p class="eyebrow text-brand-400">Computeronderhoud &middot; Herstellingen &middot; Hardware &amp; Software</p>
        <h1 class="font-display text-[clamp(2.75rem,6.4vw,5.25rem)] font-bold leading-[0.94] tracking-tight">
          Geef je computer<br />
          <span class="text-gradient-accent">een tweede jeugd.</span>
        </h1>
        <p class="max-w-lg text-white/70">
          Een computer wordt niet vanzelf trager. Stof, oude software, foutieve updates en onnodige
          achtergrondprocessen zorgen ervoor dat je pc steeds minder vlot werkt.
        </p>
        <div>
          <p class="font-display text-lg font-bold">
            <span class="text-white">I FIX</span> <span class="text-gradient-accent">IT</span>
          </p>
          <p class="mt-1 max-w-lg text-white/70">
            Ik zorg ervoor dat je computer opnieuw snel, veilig en betrouwbaar werkt.
          </p>
        </div>
        <div class="mt-2 flex flex-wrap gap-4">
          <a
            href="/contact/"
            class="btn-primary inline-flex items-center gap-2 rounded-md px-6 py-3.5 text-sm font-semibold"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4">
              <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
              <path d="M3 9h18M8 2v4M16 2v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            Maak een afspraak
          </a>
          <a
            href="https://wa.me/32476284847?text=Hallo%20Iris%2C%20ik%20heb%20een%20vraag%20over%20mijn%20computer."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary-dark inline-flex items-center gap-2 rounded-md px-6 py-3.5 text-sm font-semibold"
          >
            <IconMark name="whatsapp" class="h-4 w-4" />
            WhatsApp
          </a>
        </div>
      </div>
      <div class="diagonal-photo diagonal-photo-right relative min-h-[360px] sm:min-h-[460px] lg:min-h-0" data-reveal>
        <Image
          src={heroIris}
          alt="Iris, oprichter van ifixIT, herstelt een laptop in haar werkplaats"
          width={1200}
          height={900}
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-navy-900/60 via-transparent to-transparent lg:bg-gradient-to-l lg:from-navy-900/35 lg:via-transparent lg:to-transparent"></div>
      </div>
    </div>
  </section>

  <!-- Waarom onderhoud belangrijk -->
  <section class="bg-surface py-20 lg:py-28">
    <div class="container-page">
      <div class="max-w-xl" data-reveal>
        <h2 class="text-2xl font-bold leading-tight text-ink lg:text-3xl">
          Waarom is onderhoud belangrijk?
        </h2>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {whyPoints.map((point) => (
          <div class="card card-flood group relative overflow-hidden p-6" data-reveal>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-brand-500 to-navy-700 opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
            <div class="relative z-10">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50 transition-colors duration-300 group-hover:bg-white/15">
                <IconMark name={point.icon} class="h-6 w-6 text-brand-500 transition-colors duration-300 group-hover:text-white" />
              </div>
              <h3 class="mt-4 font-bold text-ink transition-colors duration-300 group-hover:text-white">{point.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted transition-colors duration-300 group-hover:text-white/80">{point.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Wat gebeurt er tijdens een onderhoud -->
  <section class="bg-surface-alt py-20 lg:py-28">
    <div class="container-page">
      <div class="mx-auto max-w-xl text-center" data-reveal>
        <h2 class="text-2xl font-bold text-ink sm:text-3xl">
          Wat gebeurt er tijdens een <span class="text-brand-500">onderhoud?</span>
        </h2>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((step) => (
          <div class="card card-flood group relative overflow-hidden p-6" data-reveal>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-brand-500 to-navy-700 opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
            <div class="relative z-10">
              <span class="font-mono text-sm text-brand-500 transition-colors duration-300 group-hover:text-white/70">
                {String(step.n).padStart(2, "0")}
              </span>
              <h3 class="mt-3 font-bold text-ink transition-colors duration-300 group-hover:text-white">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted transition-colors duration-300 group-hover:text-white/80">{step.description}</p>
              {step.bullets && (
                <ul class="mt-3 space-y-1 text-xs text-ink-muted transition-colors duration-300 group-hover:text-white/70">
                  {step.bullets.map((b) => (
                    <li class="flex items-center gap-1.5">
                      <span class="h-1 w-1 rounded-full bg-brand-500 transition-colors duration-300 group-hover:bg-white"></span>
                      {b}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Het resultaat -->
  <section class="bg-surface py-20 lg:py-28">
    <div class="container-page grid gap-10 lg:grid-cols-2 lg:items-center">
      <div data-reveal>
        <h2 class="text-2xl font-bold text-ink sm:text-3xl">Het resultaat</h2>
        <p class="mt-3 max-w-md text-ink-muted">Na een onderhoud merk je onmiddellijk het verschil.</p>
        <Image
          src={resultaatVisual}
          alt="Iris herstelt een computer bij ifixIT"
          width={900}
          height={600}
          loading="lazy"
          class="photo-frame mt-8 aspect-4/3 w-full object-cover"
        />
      </div>
      <div class="grid gap-6 sm:grid-cols-[1fr_auto_1fr] sm:items-center" data-reveal>
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wide text-ink-muted">Voor onderhoud</h3>
          <ul class="mt-4 space-y-3">
            {before.map((item) => (
              <li class="flex items-center gap-2.5 text-sm text-ink-muted">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5 shrink-0 text-red-500">
                  <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                  <path d="m15 9-6 6M9 9l6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="hidden justify-center sm:flex">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-8 w-8 text-brand-500">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wide text-ink-muted">Na onderhoud</h3>
          <ul class="mt-4 space-y-3">
            {after.map((item) => (
              <li class="flex items-center gap-2.5 text-sm text-ink-muted">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5 shrink-0 text-emerald-500">
                  <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                  <path d="m8 12 3 3 5-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Waarom kiezen voor I FIX IT -->
  <section class="bg-navy-900 py-20 text-white lg:py-28">
    <div class="container-page grid gap-10 lg:grid-cols-2 lg:items-center">
      <div class="diagonal-photo diagonal-photo-left relative aspect-4/3 overflow-hidden rounded-3xl lg:rounded-none" data-reveal>
        <Image
          src={waaromKiezen}
          alt="Iris van ifixIT in haar werkplaats"
          width={900}
          height={600}
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
      <div>
        <h2 class="text-2xl font-bold leading-snug sm:text-3xl" data-reveal>
          Waarom kiezen voor <span class="text-brand-400">I FIX IT?</span>
        </h2>
        <p class="mt-4 text-white/70" data-reveal>
          Geen callcenter. Geen wachtrijen. Gewoon <span class="font-semibold text-brand-400">persoonlijk</span> advies
          van een ervaren IT-specialist.
        </p>
        <div class="mt-6 grid gap-x-2 gap-y-2 sm:grid-cols-2">
          {whyChooseUs.map((item, i) => (
            <div
              class="group flex gap-3 rounded-2xl p-3 transition-colors duration-300 hover:bg-white/5"
              data-reveal
              style={`transition-delay:${i * 100}ms`}
            >
              <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10 transition-all duration-300 group-hover:scale-110 group-hover:bg-brand-500/30 group-hover:shadow-[0_0_0_6px_rgba(91,141,239,0.15)]">
                <IconMark name={item.icon} class="h-4 w-4 text-brand-400 transition-colors duration-300 group-hover:text-brand-300" />
              </div>
              <div>
                <h3 class="font-semibold transition-colors duration-300 group-hover:text-white">{item.title}</h3>
                <p class="mt-1 text-sm text-white/60 transition-colors duration-300 group-hover:text-white/80">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA banner -->
  <section class="bg-gradient-to-br from-brand-600 via-brand-500 to-navy-700">
    <div class="container-page flex flex-col items-center justify-between gap-6 py-12 text-center sm:flex-row sm:text-left lg:py-16">
      <div class="flex items-center gap-4">
        <div class="hidden h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white/15 sm:flex">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-6 w-6 text-white">
            <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
            <path d="M3 9h18M8 2v4M16 2v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="text-white">
          <h2 class="text-lg font-bold sm:text-xl">Geef je computer de zorg die hij verdient.</h2>
          <p class="mt-1 text-sm text-white/80">
            Een jaarlijks onderhoud voorkomt veel problemen en verlengt de levensduur van je computer.
          </p>
        </div>
      </div>
      <div class="flex shrink-0 flex-wrap justify-center gap-3">
        <a href="/contact/" class="inline-flex items-center gap-2 rounded-md bg-white px-5 py-3 text-sm font-semibold text-brand-700 transition-colors hover:bg-white/90">
          Maak een afspraak
        </a>
        <a
          href="https://wa.me/32476284847?text=Hallo%20Iris%2C%20ik%20heb%20een%20vraag%20over%20mijn%20computer."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-md border border-white/40 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10"
        >
          <IconMark name="whatsapp" class="h-4 w-4" />
          WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
