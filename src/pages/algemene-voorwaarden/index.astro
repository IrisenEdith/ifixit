---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Algemene voorwaarden — ifixIT"
  description="Algemene voorwaarden van ifixIT voor PC- en laptopherstellingen."
  path="/algemene-voorwaarden/"
>
  <section class="bg-navy-900 py-14 text-white">
    <div class="container-page">
      <h1 class="text-3xl font-extrabold sm:text-4xl">Algemene voorwaarden</h1>
    </div>
  </section>
  <section class="container-page max-w-3xl py-14 text-navy-900/80">
    <p class="leading-relaxed">
      Deze pagina volgt binnenkort met de volledige algemene voorwaarden van ifixIT. Voor vragen over prijzen,
      garantie of levering kan je ondertussen steeds
      <a href="/contact/" class="font-semibold text-brand-600 underline underline-offset-4">contact</a> opnemen.
    </p>
  </section>
</BaseLayout>
