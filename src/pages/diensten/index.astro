---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaceholderImage from "../../components/PlaceholderImage.astro";
import IconMark from "../../components/IconMark.astro";

const trustPoints = [
  { label: "Eerlijk & transparant", icon: "check" },
  { label: "Snelle service", icon: "clock" },
  { label: "Kwaliteit gegarandeerd", icon: "star" },
  { label: "Persoonlijk advies", icon: "chat" },
];

const hardwareServices = [
  {
    title: "Diagnose & nazicht",
    description: "Volledige controle van je computer of laptop. Ik spoor het probleem op.",
    price: "€ 25",
    note: "(verrekend bij herstelling)",
    icon: "laptop",
  },
  {
    title: "Hardware herstelling",
    description: "Herstelling of vervanging van defecte onderdelen zoals moederbord, scherm, toetsenbord, ...",
    price: "vanaf € 45",
    note: "(excl. onderdelen)",
    icon: "chip",
  },
  {
    title: "Upgrades",
    description: "Snellere prestaties? Upgrade van RAM, SSD, opslag, koeling, ...",
    price: "vanaf € 45",
    note: "(excl. onderdelen)",
    icon: "ram",
  },
  {
    title: "Reiniging & onderhoud",
    description: "Grondige reiniging van binnen + koelpasta vervangen voor betere prestaties.",
    price: "€ 45",
    note: "(laptop vanaf € 55)",
    icon: "wrench",
  },
  {
    title: "Scherm & behuizing",
    description: "Vervanging van gebarsten scherm, scharnieren, behuizing, ...",
    price: "vanaf € 65",
    note: "(excl. onderdelen)",
    icon: "screen",
  },
];

const softwareServices = [
  {
    title: "Besturingssysteem",
    description: "Installatie of herinstallatie van Windows + drivers en updates.",
    price: "€ 45",
    icon: "windows",
  },
  {
    title: "Problemen oplossen",
    description: "Traag systeem, vastlopers, fouten, blauwe schermen, opstartproblemen, ...",
    price: "€ 45 / uur",
    icon: "gear",
  },
  {
    title: "Virus & malware verwijdering",
    description: "Verwijderen van virussen, malware en ongewenste software. Beveiliging optimaliseren.",
    price: "€ 55",
    icon: "shield",
  },
  {
    title: "Back-up & gegevens herstel",
    description: "Back-up maken of herstellen van bestanden en data (indien mogelijk).",
    price: "vanaf € 45",
    icon: "cloud",
  },
  {
    title: "Optimalisatie",
    description: "Prestatie-optimalisatie en opschonen voor een snellere en stabielere computer.",
    price: "€ 45",
    icon: "speed",
  },
];

const infoBlocks = [
  {
    title: "Transparante prijzen",
    description: "De vermelde prijzen zijn incl. werkuren, excl. onderdelen. Je krijgt altijd een duidelijke prijsopgave vooraf.",
    icon: "info",
  },
  {
    title: "Ophalen & terugbrengen",
    description: "Binnen een straal van 15 km: € 10. Buiten 15 km: op aanvraag.",
    icon: "truck",
  },
];

const guarantees = [
  { title: "Geen opstartkosten", description: "Je betaalt enkel wat er gedaan wordt.", icon: "check" },
  { title: "Garantie", description: "Op alle herstellingen 3 maanden garantie.", icon: "star" },
  { title: "Tevreden of oplossen", description: "Jouw tevredenheid staat altijd voorop.", icon: "thumbsup" },
  { title: "Persoonlijk contact", description: "Eén aanspreekpunt, duidelijke communicatie.", icon: "chat" },
];
---

<BaseLayout
  title="Diensten & tarieven — ifixIT"
  description="Overzicht van alle IT-diensten en tarieven: PC & laptop herstellingen, hardware upgrades, software oplossingen, virus verwijdering, back-up en onderhoud. Heldere prijzen, geen verrassingen."
  path="/diensten/"
>
  <!-- Hero -->
  <section class="bg-navy-900 text-white">
    <div class="container-page grid gap-10 py-16 lg:grid-cols-2 lg:items-center">
      <div>
        <h1 class="text-4xl font-extrabold sm:text-5xl">
          MIJN <span class="text-brand-400">DIENSTEN</span>
        </h1>
        <p class="mt-6 max-w-xl text-white/70">
          Of het nu om hardware of software gaat, ik help je computer snel weer perfect te werken.
          Kwaliteit, eerlijkheid en persoonlijke service.
        </p>
        <div class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-4">
          {trustPoints.map((point) => (
            <div class="flex items-center gap-2">
              <IconMark name={point.icon} class="h-5 w-5 shrink-0 text-brand-400" />
              <span class="text-xs font-semibold uppercase tracking-wide text-white/80">{point.label}</span>
            </div>
          ))}
        </div>
      </div>
      <PlaceholderImage label="Onderdeel close-up" class="aspect-4/3 w-full rounded-2xl" dark />
    </div>
  </section>

  <!-- Pricing -->
  <section id="tarieven" class="scroll-mt-24 bg-slate-50 py-16">
    <div class="container-page">
      <p class="text-center text-sm font-bold uppercase tracking-[0.2em] text-brand-600">
        Overzicht van diensten &amp; prijzen
      </p>
      <h2 class="mt-3 text-center text-2xl font-extrabold text-navy-900 sm:text-3xl">
        Helder. Eerlijk. Geen verrassingen.
      </h2>

      <div id="hardware" class="mt-14 scroll-mt-24">
        <h3 class="flex items-center gap-2 text-lg font-bold text-navy-900">
          <IconMark name="wrench" class="h-5 w-5 text-brand-500" />
          Hardware diensten
        </h3>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {hardwareServices.map((service) => (
            <div class="rounded-xl border border-slate-200 bg-white p-6">
              <IconMark name={service.icon} class="h-9 w-9 text-brand-500" />
              <h4 class="mt-4 font-bold text-navy-900">{service.title}</h4>
              <p class="mt-2 text-sm leading-relaxed text-navy-900/60">{service.description}</p>
              <p class="mt-4 text-xl font-extrabold text-navy-900">{service.price}</p>
              {service.note && <p class="text-xs text-navy-900/50">{service.note}</p>}
            </div>
          ))}
        </div>
      </div>

      <div id="software" class="mt-14 scroll-mt-24">
        <h3 class="flex items-center gap-2 text-lg font-bold text-navy-900">
          <IconMark name="gear" class="h-5 w-5 text-brand-500" />
          Software diensten
        </h3>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {softwareServices.map((service) => (
            <div class="rounded-xl border border-slate-200 bg-white p-6">
              <IconMark name={service.icon} class="h-9 w-9 text-brand-500" />
              <h4 class="mt-4 font-bold text-navy-900">{service.title}</h4>
              <p class="mt-2 text-sm leading-relaxed text-navy-900/60">{service.description}</p>
              <p class="mt-4 text-xl font-extrabold text-navy-900">{service.price}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        {infoBlocks.map((block) => (
          <div class="flex items-start gap-4 rounded-xl bg-brand-50 p-5">
            <IconMark name={block.icon} class="h-6 w-6 shrink-0 text-brand-600" />
            <div>
              <h4 class="font-bold text-navy-900">{block.title}</h4>
              <p class="mt-1 text-sm text-navy-900/60">{block.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-navy-900">
    <div class="container-page grid gap-6 py-12 lg:grid-cols-[auto_1fr_auto] lg:items-center">
      <PlaceholderImage label="Laptop visual" class="mx-auto aspect-square w-32 rounded-xl lg:mx-0" dark />
      <div class="text-center text-white lg:text-left">
        <p class="text-sm font-bold uppercase tracking-wide text-brand-400">Klaar om je computer weer perfect te laten werken?</p>
        <p class="mt-1 text-white/70">Neem vandaag nog contact op voor een vrijblijvende diagnose of vraag.</p>
      </div>
      <div class="flex flex-wrap justify-center gap-3 lg:justify-end">
        <a href="/contact/" class="inline-flex items-center gap-2 rounded-md bg-brand-500 px-5 py-3 text-sm font-semibold text-white hover:bg-brand-600">
          Contacteer mij
        </a>
        <a href="tel:+3247012 3456" class="inline-flex items-center gap-2 rounded-md border border-white/25 px-5 py-3 text-sm font-semibold text-white hover:bg-white/10">
          0470 12 34 56
        </a>
      </div>
    </div>
  </section>

  <!-- Guarantees -->
  <section class="border-t border-slate-100 bg-white py-10">
    <div class="container-page grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {guarantees.map((item) => (
        <div class="flex items-start gap-3">
          <IconMark name={item.icon} class="h-6 w-6 shrink-0 text-brand-500" />
          <div>
            <h4 class="font-bold text-navy-900">{item.title}</h4>
            <p class="mt-1 text-sm text-navy-900/60">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
