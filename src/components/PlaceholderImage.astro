---
interface Props {
  label?: string;
  class?: string;
  dark?: boolean;
}

const { label = "Foto volgt", class: className = "", dark = false } = Astro.props;
---

<div
  class:list={[
    "relative flex items-center justify-center overflow-hidden",
    dark
      ? "bg-gradient-to-br from-navy-800 via-navy-700 to-navy-900"
      : "bg-gradient-to-br from-navy-700 via-brand-700 to-navy-900",
    className,
  ]}
>
  <svg
    class="absolute inset-0 h-full w-full opacity-[0.15]"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern id="grid" width="28" height="28" patternUnits="userSpaceOnUse">
        <path d="M 28 0 L 0 0 0 28" fill="none" stroke="#4f8ff7" stroke-width="1"></path>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#grid)"></rect>
  </svg>
  <div class="relative flex flex-col items-center gap-2 px-4 text-center">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-8 w-8 text-brand-400/70">
      <rect x="3" y="4" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/>
      <path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="9" cy="10" r="1.4" stroke="currentColor" stroke-width="1.3"/>
      <path d="M5.5 14.5 9 11l2.5 2.5L16 9l2.5 2.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="text-xs font-medium uppercase tracking-wide text-white/50">{label}</span>
  </div>
</div>
