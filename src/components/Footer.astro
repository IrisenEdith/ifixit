---
import { Image } from "astro:assets";
import logoIcon from "../assets/logo-icon.png";
import IconMark from "./IconMark.astro";

const year = new Date().getFullYear();
---

<footer class="bg-navy-950 text-white/70">
  <div class="container-page grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" class="flex items-center gap-2">
        <Image src={logoIcon} alt="ifixIT logo" width={72} height={66} loading="lazy" class="h-9 w-9 object-contain" />
        <span class="font-display text-xl font-bold tracking-tight">
          <span class="text-white">ifix</span><span class="text-brand-400">IT</span>
        </span>
      </a>
      <p class="mt-4 text-sm leading-relaxed text-white/60">
        Voor al je computerproblemen. Hardware of software, ik fix het!
      </p>
    </div>

    <div>
      <h3 class="font-mono text-xs uppercase tracking-widest text-brand-400">Snel naar</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href="/diensten/" class="hover:text-white">Diensten</a></li>
        <li><a href="/over-mij/" class="hover:text-white">Over mij</a></li>
        <li><a href="/diensten/#tarieven" class="hover:text-white">Tarieven</a></li>
        <li><a href="/faq/" class="hover:text-white">FAQ</a></li>
        <li><a href="/contact/" class="hover:text-white">Contact</a></li>
      </ul>
    </div>

    <div>
      <h3 class="font-mono text-xs uppercase tracking-widest text-brand-400">Diensten</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href="/diensten/#hardware" class="hover:text-white">PC &amp; laptop herstellingen</a></li>
        <li><a href="/diensten/#hardware" class="hover:text-white">Hardware upgrades</a></li>
        <li><a href="/diensten/#software" class="hover:text-white">Software oplossingen</a></li>
        <li><a href="/diensten/#software" class="hover:text-white">Virus verwijderen</a></li>
        <li><a href="/diensten/#software" class="hover:text-white">Back-up &amp; data herstel</a></li>
      </ul>
    </div>

    <div>
      <h3 class="font-mono text-xs uppercase tracking-widest text-brand-400">Contact</h3>
      <ul class="mt-4 space-y-3 text-sm">
        <li>
          <a
            href="https://wa.me/32476284847?text=Hallo%20Iris%2C%20ik%20heb%20een%20vraag%20over%20mijn%20computer."
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 hover:text-white"
          >
            <IconMark name="whatsapp" class="h-4 w-4 shrink-0 text-brand-400" />
            WhatsApp
          </a>
        </li>
        <li>
          <a href="mailto:iris@irisduym.be" class="flex items-center gap-2 hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4 shrink-0 text-brand-400">
              <rect x="2" y="4" width="20" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/>
              <path d="m2 7 10 6 10-6" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            iris@irisduym.be
          </a>
        </li>
        <li class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4 shrink-0 text-brand-400">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          Diepenbeek
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col items-center justify-between gap-3 py-6 text-xs text-white/50 sm:flex-row">
      <p>&copy; {year} ifixIT &mdash; Alle rechten voorbehouden</p>
      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
        <a href="/voorwaarden/" class="hover:text-white">Algemene voorwaarden</a>
        <a href="/algemene-voorwaarden/" class="hover:text-white">Algemene voorwaarden voor herstellingen</a>
        <a href="/privacybeleid/" class="hover:text-white">Privacybeleid</a>
      </div>
    </div>
  </div>
</footer>
