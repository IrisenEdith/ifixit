---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Pagina niet gevonden — ifixIT"
  description="Deze pagina bestaat niet (meer)."
  path="/404/"
>
  <section class="relative overflow-hidden bg-gradient-to-br from-navy-900 to-navy-600 py-24 text-center text-white">
    <div class="container-page" data-reveal>
      <p class="eyebrow justify-center text-brand-400">404</p>
      <h1 class="mt-4 text-3xl font-bold sm:text-4xl">Deze <span class="text-gradient-accent">pagina bestaat niet.</span></h1>
      <p class="mx-auto mt-4 max-w-md text-white/70">
        De pagina die je zoekt is verplaatst of bestaat niet meer. Ga terug naar de homepage of neem contact op.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-primary inline-flex items-center gap-2 rounded-md px-6 py-3 text-sm font-semibold">
          Terug naar home
        </a>
        <a href="/contact/" class="btn-secondary-dark inline-flex items-center gap-2 rounded-md px-6 py-3 text-sm font-semibold">
          Contacteer mij
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
