---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import IconMark from "../../../components/IconMark.astro";
---

<BaseLayout
  title="Bericht verzonden — ifixIT"
  description="Je bericht is verzonden. Ik neem zo snel mogelijk contact met je op."
  path="/contact/bedankt/"
>
  <section class="bg-navy-900 py-24 text-center text-white">
    <div class="container-page">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand-500/15">
        <IconMark name="check" class="h-8 w-8 text-brand-400" />
      </div>
      <h1 class="mt-6 text-3xl font-extrabold sm:text-4xl">Bedankt voor je bericht!</h1>
      <p class="mx-auto mt-4 max-w-md text-white/70">
        Je bericht is goed aangekomen. Ik neem zo snel mogelijk contact met je op.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="inline-flex items-center gap-2 rounded-md bg-brand-500 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-600">
          Terug naar home
        </a>
        <a href="tel:+3247012 3456" class="inline-flex items-center gap-2 rounded-md border border-white/25 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10">
          0470 12 34 56
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
