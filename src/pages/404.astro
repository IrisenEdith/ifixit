---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Pagina niet gevonden — ifixIT"
  description="Deze pagina bestaat niet (meer)."
  path="/404/"
>
  <section class="bg-navy-900 py-24 text-center text-white">
    <div class="container-page">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-400">404</p>
      <h1 class="mt-4 text-3xl font-extrabold sm:text-4xl">Deze pagina bestaat niet.</h1>
      <p class="mx-auto mt-4 max-w-md text-white/70">
        De pagina die je zoekt is verplaatst of bestaat niet meer. Ga terug naar de homepage of neem contact op.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="inline-flex items-center gap-2 rounded-md bg-brand-500 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-600">
          Terug naar home
        </a>
        <a href="/contact/" class="inline-flex items-center gap-2 rounded-md border border-white/25 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10">
          Contacteer mij
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
